# SIFU Informer Backend Configuration

# Server
PORT=3000
NODE_ENV=development

# MongoDB
# NOTA: Cambia esto si usas MongoDB Atlas (p.ej. mongodb+srv://usuario:password@cluster.mongodb.net/sifu_informer)
MONGODB_URI=mongodb://localhost:27017/sifu_informer
MONGODB_TEST_URI=mongodb://localhost:27017/sifu_informer_test

# JWT (Seguridad)
JWT_SECRET=sifu_informer_jwt_key_2026_secure_hash_token_string_key
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# CORS (Configurado para admitir el servidor de Vite en el puerto 5173)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-contraseña-app

# WhatsApp Business API
WHATSAPP_API_KEY=tu_whatsapp_api_key
WHATSAPP_PHONE_NUMBER=+34600123456
WHATSAPP_API_URL=https://api.whatsapp.com/v1

# Google Calendar API
GOOGLE_API_KEY=tu_google_api_key
GOOGLE_CALENDAR_ID=primary

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Cron Jobs
ENABLE_CRON_JOBS=false
WEEKLY_REPORT_CRON=0 9 * * 1
CONTRACT_CHECK_CRON=0 8 * * *
